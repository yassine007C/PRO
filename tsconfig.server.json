{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020"
  },
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "client", "build", "dist", "**/*.test.ts"]
}
